load("@rules_rust_prost//:defs.bzl", "rust_prost_library")
load(":opt.bzl", "cgo_rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

# gazelle:resolve rs import_extractor_proto :import_extractor_rust_proto
# gazelle:resolve rs prost @rules_rs//rs/private/prost:prost_runtime

# proto_library lives at //proto:import_extractor_proto so that //rs/proto can
# depend on it without loading any rules_rs symbols.
rust_prost_library(
    name = "import_extractor_rust_proto",
    proto = "//proto:import_extractor_proto",
    visibility = ["//visibility:public"],
)

# rlib variant — linked through cgo by //rs and used by the unit tests.
cgo_rust_library(
    name = "import_extractor",
    srcs = [
        "src/ffi.rs",
        "src/lib.rs",
        "src/rust.rs",
        "src/wire.rs",
    ],
    crate_name = "gazelle_rs_import_extractor",
    crate_root = "src/lib.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        ":import_extractor_rust_proto",
        "@rules_rs//rs/private/prost:prost_runtime",
        "@gazelle_rs_crates//:semver",
        "@gazelle_rs_crates//:syn",
    ],
)

rust_test(
    name = "test",
    srcs = [
        "src/ffi.rs",
        "src/ffi.test.rs",
        "src/lib.rs",
        "src/rust.rs",
        "src/rust.test.rs",
        "src/wire.rs",
    ],
    crate_name = "gazelle_rs_import_extractor",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = [
        ":import_extractor_rust_proto",
        "@rules_rs//rs/private/prost:prost_runtime",
        "@gazelle_rs_crates//:semver",
        "@gazelle_rs_crates//:syn",
    ],
)
