load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_binary(
    name = "app",
    srcs = ["src/main.rs"],
    crate_name = "app",
    crate_root = "src/main.rs",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "//presentation",
        "//service",
        "@mixed_example_crates//:anyhow",
    ],
)

rust_test(
    name = "workflow_test",
    srcs = ["tests/workflow.rs"],
    crate_name = "workflow_test",
    crate_root = "tests/workflow.rs",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "//presentation",
        "//service",
        "@mixed_example_crates//:anyhow",
        "@mixed_example_crates//:serde_json",
    ],
)
