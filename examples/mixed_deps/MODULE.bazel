module(name = "gazelle_rs_mixed_deps_example")

bazel_dep(name = "gazelle_rs", version = "0.0.0")
local_path_override(
    module_name = "gazelle_rs",
    path = "../..",
)

bazel_dep(name = "gazelle", version = "0.51.3")
bazel_dep(name = "rules_rs", version = "0.0.111")
bazel_dep(name = "llvm", version = "0.8.18")

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "mixed_example_crates",
    cargo_lock = "//third_party:Cargo.lock",
    cargo_toml = "//third_party:Cargo.toml",
    platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "mixed_example_crates")
