load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "consumer",
    srcs = ["src/lib.rs"],
    aliases = {"@fixture_crates//:codec-1.0.0": "renamed"},
    crate_root = "src/lib.rs",
    deps = ["@fixture_crates//:codec-1.0.0"],
)

rust_test(
    name = "renamed_consumer_test",
    srcs = ["src/consumer.test.rs"],
    aliases = {"@fixture_crates//:codec-1.0.0": "renamed"},
    crate_root = "src/consumer.test.rs",
    deps = ["@fixture_crates//:codec-1.0.0"],
)

rust_test(
    name = "version_test",
    srcs = ["version.test.rs"],
    crate_root = "version.test.rs",
    deps = ["@fixture_crates//:codec-2.0.0"],
)
