load("@rules_go//proto:def.bzl", "go_proto_library")

# Keep package discoverable by Go tooling; Bazel generates its bindings.
# gazelle:exclude doc.go

# Go bindings for the import-extractor wire protocol. The proto_library lives
# at //proto so that consumers load only the schema and Go rules.
go_proto_library(
    name = "import_extractor_go_proto",
    importpath = "github.com/perplexityai/gazelle_rs/rs/proto",
    proto = "//proto:import_extractor_proto",
    visibility = ["//rs:__subpackages__"],
)
