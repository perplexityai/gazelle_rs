load("@gazelle//:def.bzl", "gazelle_binary")
load("@rules_go//go:def.bzl", "go_test")

gazelle_binary(
    name = "gazelle_test_gazelle_bin",
    testonly = True,
    languages = ["//rs"],
)

go_test(
    name = "gazelle_test_test",
    size = "medium",
    srcs = ["gazelle_test.go"],
    args = ["-gazelle_binary=$(rlocationpath :gazelle_test_gazelle_bin)"],
    data = [":gazelle_test_gazelle_bin"] + glob(["testdata/**"]),
    deps = [
        "@gazelle//testtools",
        "@rules_go//go/runfiles",
    ],
)
