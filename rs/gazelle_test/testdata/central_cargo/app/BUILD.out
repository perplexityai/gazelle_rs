load("@rules_rs//rs:rust_library.bzl", "rust_library")

rust_library(
    name = "app",
    srcs = ["lib.rs"],
    aliases = {
        "@vendor//:wire-codec": "renamed",
    },
    crate_name = "app",
    crate_root = "lib.rs",
    edition = "2021",
    proc_macro_deps = ["@vendor//:derive-package-1.0.0"],
    deps = ["@vendor//:wire-codec"],
)
