rust_library(
    name = "unrelated_quote",
    srcs = ["lib.rs"],
    crate_name = "unrelated_quote",
    crate_root = "lib.rs",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:imported_dep",
        "@crates//:parse_dep",
        "@crates//:parse_spanned_dep",
        "@crates//:qualified_dep",
        "@crates//:spanned_dep",
