load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "sample",
    srcs = ["lib.rs"],
    crate_name = "sample",
    crate_root = "lib.rs",
    edition = "2021",
)

rust_test(
    name = "explicit_shared",
    srcs = ["shared.test.rs"],
    crate_name = "explicit_shared",
    crate_root = "shared.test.rs",
    edition = "2021",
)

rust_test(
    name = "manifest_override",
    srcs = ["manifest.test.rs"],
    crate_name = "manifest_override",
    crate_root = "manifest.test.rs",
    edition = "2021",
)

rust_test(
    name = "explicit_standalone_tests_test",
    srcs = ["api.test.rs"],
    crate_name = "explicit_standalone_tests_test",
    edition = "2021",
    deps = [":sample"],
)

rust_test(
    name = "sample_test",
    srcs = [
        "lib.rs",
        "manifest.test.rs",
        "shared.test.rs",
    ],
    crate_name = "sample",
    crate_root = "lib.rs",
    edition = "2021",
)
