load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "sample",
    srcs = ["lib.rs"],
    crate_root = "lib.rs",
)

rust_test(
    name = "explicit_shared",
    srcs = ["shared.test.rs"],
    crate_root = "shared.test.rs",
)
