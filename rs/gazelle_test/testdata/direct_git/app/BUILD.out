load("@rules_rs//rs:rust_library.bzl", "rust_library")

rust_library(
    name = "app",
    srcs = ["lib.rs"],
    aliases = {
        "@vendor//:wire-codec": "codec",
    },
    crate_name = "app",
    crate_root = "lib.rs",
    edition = "2021",
    deps = [
        "@vendor//:git-util",
        "@vendor//:wire-codec",
    ],
)
