load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//:rules.bzl", "custom_library")

rust_library(
    name = "raw",
    srcs = ["raw.rs"],
)

rust_test(
    name = "raw_test",
    crate = ":raw",
)

custom_library(
    name = "api",
    srcs = ["api.rs"],
)
