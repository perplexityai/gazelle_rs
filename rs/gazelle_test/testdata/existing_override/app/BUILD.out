load("@rules_rs//rs:rust_binary.bzl", "rust_binary")

# gazelle:resolve rs external @third_party//:external

rust_binary(
    name = "app",
    srcs = ["main.rs"],
    crate_name = "app",
    crate_root = "main.rs",
    edition = "2021",
    deps = [
        "//api:custom",
        "@third_party//:external",
    ],
)
