load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "computed",
    srcs = select({"//conditions:default": ["lib.rs", "lib.test.rs"]}),
    crate_root = "lib.rs",
)

rust_test(
    name = "computed_test",
    crate = ":computed",
)
