# gazelle:proto_strip_import_prefix /proto
# gazelle:proto_import_prefix gazelle_rs
# gazelle:go_generate_proto false
load("@rules_proto//proto:defs.bzl", "proto_library")

# Rust parser and Go plugin exchange these messages across the cgo FFI boundary.
# Namespace descriptor paths so consumers loading multiple Gazelle extensions
# don't trigger Go protobuf's duplicate-file-registration panic.
proto_library(
    name = "import_extractor_proto",
    srcs = ["message.proto"],
    import_prefix = "gazelle_rs",
    strip_import_prefix = "/proto",
    visibility = ["//visibility:public"],
)
