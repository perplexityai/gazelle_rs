# Shared by the root module and standalone examples.
build:ci --build_metadata=ROLE=CI
build:ci --build_metadata=REPO_URL=https://github.com/perplexityai/gazelle_rs.git
build:ci --bes_backend=grpcs://remote.buildbuddy.io
build:ci --bes_results_url=https://app.buildbuddy.io/invocation/
build:ci --bes_upload_mode=wait_for_upload_complete
build:ci --remote_cache=grpcs://remote.buildbuddy.io
build:ci --remote_executor=grpcs://remote.buildbuddy.io
# Untrusted builds may write CAS blobs, never action-cache entries.
build:ci --noremote_upload_local_results
build:ci --remote_cache_compression
build:ci --remote_timeout=10m
build:ci --jobs=50
build:ci --extra_execution_platforms=@gazelle_rs//platforms:buildbuddy_linux_x86_64_gnu
build:ci --platforms=@gazelle_rs//platforms:buildbuddy_linux_x86_64_gnu
